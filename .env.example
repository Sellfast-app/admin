# Base URL of the Swiftree backend API (staging example below).
# All /api/admin/* routes forward to <ADMIN_API_BASE_URL>/admin/...
ADMIN_API_BASE_URL=https://staging.swiftree.app

# Shared secret for server-to-server requests (optional; sent as X-Internal-Secret).
# Same value already used by the vendor app.
INTERNAL_SECRET=

# Fallback used only when ADMIN_API_BASE_URL is not set (matches vendor app config).
NEXT_PUBLIC_API_BASE_URL=
