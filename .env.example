# Backend origin, without /admin. Set explicitly for the target environment.
ADMIN_API_BASE_URL=

# Current backend contract has no auth. Keep access private until auth is added.
# Enable only after dedicated admin login and session endpoints are confirmed.
ADMIN_AUTH_ENABLED=false

# Shared secret for server-to-server requests (optional; sent as X-Internal-Secret).
# Same value already used by the vendor app.
INTERNAL_SECRET=

# Fallback used only when ADMIN_API_BASE_URL is not set (matches vendor app config).
NEXT_PUBLIC_API_BASE_URL=
